<div>
    <h1>Cadastrar Missa</h1>
    <div>
        <div>
            <div>
                <i></i>
                <label for="">Celebração</label>
            </div>
            <div>
                <input type="text" name="name" placeholder="Nome da Missa">
            </div>
        </div>
        <div>
            <div>
                <i></i>
                <label for="">Data</label>
            </div>
            <div>
                <input type="date" name="date">
            </div>
        </div>
        <div>
            <div>
                <i></i>
                <label for="">Horário</label>
            </div>
            <div>
                <input type="time" name="time">
            </div>
        </div>
        <div>
            <div>
                <i></i>
                <label for="">Local</label>
            </div>
            <div>
                <input type="text" name="location" placeholder="Local da Missa">
            </div>
        </div>
        <div>
            <div>
                <i></i>
                <label for="">Observações</label>
            </div>
            <div>
                <textarea name="observations" placeholder="Observações"></textarea>
            </div>
        </div>
    </div>
</div>