<script src="/js/acolitos/cadastrar.js"></script>

<section class="page">
    <div class="page__head">
        <div>
            <p class="eyebrow">Acólitos</p>
            <h1 class="page__title">Novo acólito</h1>
            <p class="page__sub">Cadastre quem serve ao altar para poder incluí-lo nas escalas.</p>
        </div>
        <div class="page__actions">
            <a class="btn btn-ghost" href="/acolitos"><i class="bi bi-arrow-left"></i> Voltar</a>
        </div>
    </div>

    <form class="card form-card" onsubmit="return false">
        <span class="form-card__accent" aria-hidden="true"></span>
        <div class="form-card__body">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label" for="nome">Nome</label>
                    <input type="text" class="form-control" name="nome" id="nome" placeholder="Nome completo do acólito">
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="status">Situação</label>
                    <select class="form-select" name="status" id="status">
                        <option value="">Selecione</option>
                        <option value="ATIVO">Ativo</option>
                        <option value="INATIVO">Inativo</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-card__foot">
            <a class="btn btn-ghost" href="/acolitos">Cancelar</a>
            <button type="button" id="btn-Cadastro" class="btn btn-primary">Cadastrar</button>
        </div>
    </form>
</section>
