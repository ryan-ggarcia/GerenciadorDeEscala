<script src="/js/acolitos/excluir.js"></script>

<section class="page">
    <div class="page__head">
        <div>
            <p class="eyebrow">Cadastro</p>
            <h1 class="page__title">Acólitos</h1>
            <p class="page__sub">Quem serve ao altar. Marque como inativo quem estiver afastado.</p>
        </div>
        <div class="page__actions">
            <a class="btn btn-outline-accent" href="/acolitos/cadastrar"><i class="bi bi-plus-lg"></i> Novo acólito</a>
        </div>
    </div>

    <div class="card panel">
        <div class="panel__tools">
            <label class="search">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control" data-table-filter placeholder="Buscar acólito&hellip;" aria-label="Buscar acólito">
            </label>
            <span class="panel__count"></span>
        </div>

        <% if (acolitos_list && acolitos_list.length > 0) { %>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Situação</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% acolitos_list.forEach(acolito => { %>
                            <tr>
                                <td class="cell-primary">
                                    <a href="/acolitos/alterar/<%= acolito.aco_id %>"><%= acolito.aco_nome %></a>
                                </td>
                                <td>
                                    <% if (acolito.aco_status === 'ATIVO') { %>
                                        <span class="badge-status badge-status--ok">Ativo</span>
                                    <% } else { %>
                                        <span class="badge-status badge-status--muted">Inativo</span>
                                    <% } %>
                                </td>
                                <td class="cell-actions">
                                    <a class="icon-btn" href="/acolitos/alterar/<%= acolito.aco_id %>" aria-label="Editar acólito"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="icon-btn icon-btn--danger btn-excluir" data-id="<%= acolito.aco_id %>" aria-label="Excluir acólito"><i class="bi bi-trash3"></i></button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty">
                <i class="bi bi-person empty__icon"></i>
                Nenhum acólito cadastrado. <a href="/acolitos/cadastrar">Cadastrar o primeiro</a>.
            </div>
        <% } %>
    </div>
</section>
