<h1> Alterar Escala </h1>
<script src="/js/escala/alterar.js"></script>

<div>
    <div>
        <div>
            <input type="text" hidden name="id" placeholder="Id da Escala" id="id" value="<%= findEscala.esc_id %>">
        </div>
    </div>
    <div>
        <div>
            <i></i>
            <label for="">Missa</label>
        </div>
        <div>
            <select name="mis_id" id="mis_id">
                <% missa_list.forEach(missa => { %>
                    <option value="<%= missa.mis_id %>" <%= missa.mis_id === findEscala.mis_id ? 'selected' : '' %>><%= missa.mis_nome %> - <%= new Date(missa.mis_dia).toLocaleDateString('pt-BR') %></option>
                <% }) %>
            </select>
        </div>
    </div>
    <div>
        <div>
            <i></i>
            <label for="">Acólito</label>
        </div>
        <div>
            <select name="aco_id" id="aco_id">
                <% acolitos_list.forEach(acolito => { %>
                    <option value="<%= acolito.aco_id %>" <%= acolito.aco_id === findEscala.aco_id ? 'selected' : '' %>><%= acolito.aco_nome %></option>
                <% }) %>
            </select>
        </div>
    </div>
    <div>
        <div>
            <i></i>
            <label for="">Função</label>
        </div>
        <div>
            <select name="fun_id" id="fun_id">
                <% funcao_list.forEach(funcao => { %>
                    <option value="<%= funcao.fun_id %>" <%= funcao.fun_id === findEscala.fun_id ? 'selected' : '' %>><%= funcao.fun_nome %></option>
                <% }) %>
            </select>
        </div>
    </div>
    <div>
        <div>
            <i></i>
            <label for="">Status</label>
        </div>
        <div>
            <select name="status" id="status">
                <option value="CONVOCADO" <%= findEscala.esc_status === 'CONVOCADO' ? 'selected' : '' %>>CONVOCADO</option>
                <option value="CONFIRMADO" <%= findEscala.esc_status === 'CONFIRMADO' ? 'selected' : '' %>>CONFIRMADO</option>
                <option value="RECUSADO" <%= findEscala.esc_status === 'RECUSADO' ? 'selected' : '' %>>RECUSADO</option>
            </select>
        </div>
    </div>
    <div>
        <button type="button" id="btn-Alterar">Alterar</button>
    </div>
</div>
