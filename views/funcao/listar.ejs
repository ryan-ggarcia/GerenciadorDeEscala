<script src="/js/funcao/excluir.js"></script>

<section class="page">
    <div class="page__head">
        <div>
            <p class="eyebrow">Cadastro</p>
            <h1 class="page__title">Funções</h1>
            <p class="page__sub">Os papéis no altar &mdash; turíbulo, cruz, ceroferário, naveta, librífero.</p>
        </div>
        <div class="page__actions">
            <a class="btn btn-outline-accent" href="/funcao/cadastrar"><i class="bi bi-plus-lg"></i> Nova função</a>
        </div>
    </div>

    <div class="card panel">
        <div class="panel__tools">
            <label class="search">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control" data-table-filter placeholder="Buscar função&hellip;" aria-label="Buscar função">
            </label>
            <span class="panel__count"></span>
        </div>

        <% if (funcao_list && funcao_list.length > 0) { %>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Descrição</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% funcao_list.forEach(funcao => { %>
                            <tr>
                                <td class="cell-primary">
                                    <a href="/funcao/alterar/<%= funcao.fun_id %>"><%= funcao.fun_nome %></a>
                                </td>
                                <td class="cell-muted"><%= funcao.fun_descricao || '—' %></td>
                                <td class="cell-actions">
                                    <a class="icon-btn" href="/funcao/alterar/<%= funcao.fun_id %>" aria-label="Editar função"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="icon-btn icon-btn--danger btn-excluir" data-id="<%= funcao.fun_id %>" aria-label="Excluir função"><i class="bi bi-trash3"></i></button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty">
                <i class="bi bi-bookmark-star empty__icon"></i>
                Nenhuma função cadastrada. <a href="/funcao/cadastrar">Cadastrar a primeira</a>.
            </div>
        <% } %>
    </div>
</section>
