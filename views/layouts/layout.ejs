<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestão de Escala</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="/css/app.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
<%
    const nav = [
        { href: '/',              icon: 'bi-house-door',      label: 'Início' },
        { href: '/missa',         icon: 'bi-calendar2-week',  label: 'Missas' },
        { href: '/escala',        icon: 'bi-list-check',      label: 'Escalas' },
        { href: '/acolitos',      icon: 'bi-person',          label: 'Acólitos' },
        { href: '/funcao',        icon: 'bi-bookmark-star',   label: 'Funções' },
        { href: '/acolitofuncao', icon: 'bi-patch-check',     label: 'Habilitações' },
        { href: '/indisponivel',  icon: 'bi-calendar-x',      label: 'Indisponibilidades' }
    ];
    let hoje = new Date().toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long' });
    hoje = hoje.charAt(0).toUpperCase() + hoje.slice(1);
%>
<div class="app">

    <aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebar" aria-labelledby="sidebarLabel">
        <div class="offcanvas-header d-lg-none">
            <span class="offcanvas-title" id="sidebarLabel">Menu</span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Fechar"></button>
        </div>

        <div class="offcanvas-body sidebar__inner">
            <div class="sidebar__brand">
                <span class="sidebar__emblem" aria-hidden="true">&#10013;</span>
                <span>
                    <span class="sidebar__name">Paróquia Rainha dos Apóstolos</span>
                    <span class="sidebar__tag">Gestão de Escala</span>
                </span>
            </div>

            <nav class="sidebar__nav">
                <% nav.forEach(item => { %>
                    <a class="sidebar__link" href="<%= item.href %>">
                        <i class="bi <%= item.icon %>"></i><%= item.label %>
                    </a>
                <% }) %>
            </nav>

            <a class="sidebar__cta btn btn-primary" href="/escala/cadastrar">
                <i class="bi bi-plus-lg"></i> Nova escala
            </a>
        </div>
    </aside>

    <div class="app__main">
        <header class="topbar">
            <button class="topbar__toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Abrir menu">
                <i class="bi bi-list"></i>
            </button>
            <span class="topbar__wordmark d-lg-none">Paróquia</span>
            <span class="topbar__date"><%= hoje %></span>
        </header>

        <main class="content">
            <%- body %>
        </main>

        <footer class="site-footer">
            <div class="site-footer__inner">
                <p class="site-footer__by">Desenvolvido por <strong>Ryan Fidelis</strong></p>
                <nav class="site-footer__links" aria-label="Contato do desenvolvedor">
                    <a href="https://github.com/ryan-ggarcia" target="_blank" rel="noopener">
                        <i class="bi bi-github" aria-hidden="true"></i> GitHub
                    </a>
                    <a href="https://www.linkedin.com/in/ryan-fidelis-34b884322/" target="_blank" rel="noopener">
                        <i class="bi bi-linkedin" aria-hidden="true"></i> LinkedIn
                    </a>
                </nav>
            </div>
        </footer>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/table-filter.js"></script>
<script>
    (function () {
        var path = window.location.pathname.replace(/\/+$/, '') || '/';
        document.querySelectorAll('.sidebar__link').forEach(function (link) {
            var href = new URL(link.href).pathname.replace(/\/+$/, '') || '/';
            var active = href === '/' ? path === '/' : (path === href || path.indexOf(href + '/') === 0);
            if (active) link.classList.add('is-active');
        });
    })();
</script>
</body>
</html>
